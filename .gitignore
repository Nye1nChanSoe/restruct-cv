# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated native PyMuPDF inspection dumps; retain the empty directory.
debug/*
!debug/.gitkeep

# Holdout inputs and their generated results stay local.
truths/*
!truths/.gitkeep
results/truths/
