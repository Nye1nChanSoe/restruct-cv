# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated native PyMuPDF inspection dumps; retain the empty directory.
debug/*
!debug/.gitkeep
!debug/ocr/
debug/ocr/*
!debug/ocr/.gitkeep

# Pass 1-4 overlays are large, regenerate on every run, and are opt-in by
# design; they stay local rather than in the repository. Only the combined
# pass-5 overlay is committed.
results/*/debug/pass-*/

# Overlays for the unsupported-layout fixtures; inputs are committed, the
# rendered evidence is not.
results/1-unsupported/

# Reconstructions are drawn from a committed resume.json, so committing them
# too would store the same information twice and let the two disagree.
results/*/reconstruction/
results/*/*-reconstruction.pdf
results/*/*-page-*.png

# Holdout inputs and their generated results stay local.
resumes-truths/*
!resumes-truths/.gitkeep
results/0-truths/

# Project-local Hugging Face weights stay untracked; retain the model store.
models/*
!models/.gitkeep

# Pytest cache
.pytest_cache/
