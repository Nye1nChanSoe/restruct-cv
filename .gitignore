# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local publishing credentials. Keep the placeholder template tracked.
.env.pypi

# Generated native PyMuPDF inspection dumps; retain the empty directory.
debug/*
!debug/.gitkeep
!debug/ocr/
debug/ocr/*
!debug/ocr/.gitkeep

# Every run rewrites results/, and the overlays in it are large -- 113MB of
# them was most of this repository's history before they were removed from it.
# Three resumes are kept as committed evidence under examples/, copied there by
# tools/refresh_examples.py; nothing in results/ is tracked.
results/

# Holdout inputs and their generated results stay local.
resumes-truths/*
!resumes-truths/.gitkeep

# Reconstructions are drawn from a committed resume.json, so committing them
# too would store the same information twice and let the two disagree.
examples/*/*-reconstruction.pdf
examples/*/*-page-*.png

# Project-local Hugging Face weights stay untracked; retain the model store.
models/*
!models/.gitkeep

# Pytest cache
.pytest_cache/
